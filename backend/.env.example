PORT=3000
NODE_ENV=development

# Internal NLP processing node
FASTAPI_URL=http://localhost:8000

# Semantic Scholar Academic Graph
# Leave S2AG_API_KEY empty to call S2AG unauthenticated (lower rate limit).
# Get a key at https://www.semanticscholar.org/product/api to raise limits.
S2AG_API_KEY=
S2AG_BASE_URL=https://api.semanticscholar.org/graph/v1

# Upload limit (bytes) and gateway cache TTL (ms)
MAX_UPLOAD_BYTES=15728640
CACHE_TTL_MS=300000
