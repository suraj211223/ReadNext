# =============================================================================
# Contextual Research Recommender — example environment
# Copy the relevant blocks into backend/.env and processing/.env
# =============================================================================

# ---- API Gateway (backend/.env) ---------------------------------------------
PORT=3000
NODE_ENV=development
FASTAPI_URL=http://localhost:8000
# Leave S2AG_API_KEY empty to call Semantic Scholar unauthenticated (lower rate
# limit). Get a key at https://www.semanticscholar.org/product/api to raise it.
S2AG_API_KEY=
S2AG_BASE_URL=https://api.semanticscholar.org/graph/v1
MAX_UPLOAD_BYTES=15728640
CACHE_TTL_MS=300000

# ---- Processing Node / NLP engine (processing/.env) -------------------------
HOST=0.0.0.0
# NOTE: the engine listens on 8000; key name kept as PORT for the engine's .env
KEYBERT_MODEL=all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm
MIN_KEYWORDS=5
MAX_KEYWORDS=7
NGRAM_MIN=1
NGRAM_MAX=3
RAKE_CHAR_THRESHOLD=6000
TESSERACT_CMD=/opt/homebrew/bin/tesseract
